TOP_LIBRARY := work
TOP_MODULE := gate8

NVC := nvc
NVC_OPT := --std=2008

NVC_ANALYSIS_OPT := 

NVC_ELAB_OPT := 

#target for performing local simulation
local: sim_pre_cmd simulation sim_post_cmd

VERILOG_SRC := 
VERILOG_OBJ := 
VHDL_SRC := ../files/gate.vhdl \
../files/gate8.vhdl \

VHDL_OBJ := gatelib/gate/.gate_vhdl \
work/gate8/.gate8_vhdl \

LIBS := gatelib work
LIB_IND := gatelib/.gatelib work/.work

simulation: $(VERILOG_OBJ) $(VHDL_OBJ)
		$(NVC) -L . $(NVC_OPT) -e $(NVC_ELAB_OPT) $(TOP_MODULE)


gatelib/gate/.gate_vhdl: ../files/gate.vhdl
		$(NVC) -L . --work=gatelib $(NVC_OPT) -a $(NVC_ANALYSIS_OPT) $<
		@mkdir -p $(dir $@) && touch $@


work/gate8/.gate8_vhdl: ../files/gate8.vhdl \
gatelib/gate/.gate_vhdl
		$(NVC) -L . --work=work $(NVC_OPT) -a $(NVC_ANALYSIS_OPT) $<
		@mkdir -p $(dir $@) && touch $@


# USER SIM COMMANDS
sim_pre_cmd:
	
sim_post_cmd:
	

CLEAN_TARGETS := $(LIBS) *.cf *.o $(TOP_MODULE) work

clean:
		rm -rf $(CLEAN_TARGETS)
mrproper: clean
		rm -rf *.vcd

.PHONY: mrproper clean sim_pre_cmd sim_post_cmd simulation
